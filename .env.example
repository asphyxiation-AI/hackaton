# Имя провайдера (метка конфигурации)
LLM_PROVIDER=openai

# Ключ API выбранного провайдера — замените значение.
OPENAI_API_KEY=your_key_here

# OpenAI-совместимый URL чат-API (должен оканчиваться на /v1).
# Примеры замены:
#   OpenAI                       https://api.openai.com/v1
#   Qwen3 (DashScope)            https://dashscope.aliyuncs.com/compatible-mode/v1
#   Alice AI ART / vLLM-шлюз     http://<host>:<port>/v1
#   YandexGPT (совместимый шлюз) http://<host>:<port>/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# Идентификатор модели в каталоге провайдера (например: gpt-oss-120b).
MODEL_NAME=gpt-oss-120b